<?xml version="1.0" encoding="utf-8"?>

<resources>
    <!-- ===== Temporal ===== -->
    <style name="Rampify" />

    <!-- ===== BOTONES ===== -->
    <style name="Widget.Rampify.Button" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14dp</item>
    </style>

    <style name="Widget.Rampify.Button.Primary">
        <item name="backgroundTint">@color/app_primary</item>
        <item name="android:textColor">@color/app_on_primary</item>
    </style>

    <style name="Widget.Rampify.Button.Delete">
        <item name="backgroundTint">@color/btn_delete</item>
    </style>

    <style name="Widget.Rampify.Button.Edit">
        <item name="backgroundTint">@color/btn_edit</item>
    </style>

    <style name="Widget.Rampify.Button.Action">
        <item name="backgroundTint">@color/btn_action</item>
    </style>

    <!-- ===== CAMPO DE TEXTO ===== -->
    <style name="Widget.Rampify.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/app_outline</item>
        <item name="hintTextColor">@color/app_primary</item>
    </style>

    <!-- ===== TEXTOS Y CAMPOS (apegados a clase: parent AppCompat) ===== -->
    <style name="Rampify.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14sp</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:textColorHint">@color/app_on_surface_variant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Rampify.Title" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">@color/app_on_background</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Rampify.Subtitle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/app_on_surface_variant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Rampify.Label" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/app_on_background</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Rampify.Link" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/app_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Rampify.CheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textColor">@color/app_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
        <item name="buttonTint">@color/app_primary</item>
    </style>
    <style name="Widget.Rampify.Button.Secondary">
        <item name="backgroundTint">@color/app_surface</item>
        <item name="android:textColor">@color/app_primary</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Rampify.EditText.Multiline">
        <item name="android:singleLine">false</item>
        <item name="android:gravity">top|start</item>
        <item name="android:minLines">4</item>
    </style>

    <style name="Rampify.MenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Rampify.RadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="buttonTint">@color/app_primary</item>
    </style>

    <style name="Rampify.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>