<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_surface"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_outline_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMenuMapa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_map"
            android:drawablePadding="2dp"
            android:drawableTint="@color/app_on_surface_variant"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/map_navigation"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMenuHistorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_history"
            android:drawablePadding="2dp"
            android:drawableTint="@color/app_on_surface_variant"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/history"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMenuPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_profile"
            android:drawablePadding="2dp"
            android:drawableTint="@color/app_on_surface_variant"
            android:focusable="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/profile"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>