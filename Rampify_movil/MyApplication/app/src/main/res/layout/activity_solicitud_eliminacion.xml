<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="@string/back"
            style="@style/Rampify.Link" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/request_deletion_title"
            style="@style/Rampify.Title" />

        <TextView
            android:id="@+id/tvFolioSolicitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            style="@style/Rampify.Subtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/why_delete_report"
            style="@style/Rampify.Label" />

        <RadioGroup
            android:id="@+id/rgMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rbError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reason_mistake"
                style="@style/Rampify.RadioButton" />

            <RadioButton
                android:id="@+id/rbDuplicado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reason_duplicate"
                style="@style/Rampify.RadioButton" />

            <RadioButton
                android:id="@+id/rbResuelto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reason_resolved"
                style="@style/Rampify.RadioButton" />

            <RadioButton
                android:id="@+id/rbDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reason_incorrect"
                style="@style/Rampify.RadioButton" />

            <RadioButton
                android:id="@+id/rbOtro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reason_other"
                style="@style/Rampify.RadioButton" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/optional_comments"
            style="@style/Rampify.Label" />

        <EditText
            android:id="@+id/etComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/request_details_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="300"
            style="@style/Rampify.EditText.Multiline" />

        <Button
            android:id="@+id/btnEnviarSolicitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/send_request"
            style="@style/Widget.Rampify.Button.Delete" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cancel"
            style="@style/Widget.Rampify.Button.Secondary" />

    </LinearLayout>
</ScrollView>