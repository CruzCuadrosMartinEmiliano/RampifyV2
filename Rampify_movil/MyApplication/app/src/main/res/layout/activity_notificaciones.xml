<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="@string/back"
        style="@style/Rampify.Link" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/notifications"
        style="@style/Rampify.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/notification_intro"
        style="@style/Rampify.Subtitle" />

    <Switch
        android:id="@+id/swEstado"
        android:checked="true"
        android:text="@string/notify_report_status"
        style="@style/Rampify.Switch" />

    <Switch
        android:id="@+id/swCercanos"
        android:checked="true"
        android:text="@string/notify_nearby_reports"
        style="@style/Rampify.Switch" />

    <Switch
        android:id="@+id/swSolicitudes"
        android:checked="true"
        android:text="@string/notify_request_response"
        style="@style/Rampify.Switch" />

    <Switch
        android:id="@+id/swNovedades"
        android:checked="false"
        android:text="@string/notify_app_updates"
        style="@style/Rampify.Switch" />

</LinearLayout>