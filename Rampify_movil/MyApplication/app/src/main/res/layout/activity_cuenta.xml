<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="@string/back"
            style="@style/Rampify.Link" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/account_settings"
            style="@style/Rampify.Title" />

        <TextView
            android:id="@+id/tvCorreoActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/current_email_placeholder"
            style="@style/Rampify.Subtitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/app_language"
            style="@style/Rampify.MenuItem" />

        <RadioGroup
            android:id="@+id/rgIdioma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbIdiomaEspanol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/spanish" />

            <RadioButton
                android:id="@+id/rbIdiomaIngles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/english" />
        </RadioGroup>

        <!-- Opciones -->
        <TextView
            android:id="@+id/opCambiarCorreo"
            android:text="@string/change_email"
            style="@style/Rampify.MenuItem" />

        <!-- Formulario correo (oculto) -->
        <LinearLayout
            android:id="@+id/formCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etNuevoCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/new_email"
                android:inputType="textEmailAddress"
                style="@style/Rampify.EditText" />

            <Button
                android:id="@+id/btnGuardarCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/save_email"
                style="@style/Widget.Rampify.Button.Action" />
        </LinearLayout>

        <TextView
            android:id="@+id/opCambiarPassword"
            android:text="@string/change_password"
            style="@style/Rampify.MenuItem" />

        <!-- Formulario contraseña (oculto) -->
        <LinearLayout
            android:id="@+id/formPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etPasswordActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/current_password"
                android:inputType="textPassword"
                style="@style/Rampify.EditText" />

            <EditText
                android:id="@+id/etPasswordNueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/new_password_minimum"
                android:inputType="textPassword"
                style="@style/Rampify.EditText" />

            <Button
                android:id="@+id/btnGuardarPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/save_password"
                style="@style/Widget.Rampify.Button.Action" />
        </LinearLayout>

        <TextView
            android:id="@+id/opCerrarSesion"
            android:text="@string/logout"
            style="@style/Rampify.MenuItem" />

        <TextView
            android:id="@+id/tvEstadoEliminacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/deletion_pending"
            android:visibility="gone"
            style="@style/Rampify.Subtitle" />

        <Button
            android:id="@+id/btnCancelarEliminacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cancel_account_deletion"
            android:visibility="gone"
            style="@style/Widget.Rampify.Button.Secondary" />

        <Button
            android:id="@+id/btnEliminarCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/request_account_deletion"
            style="@style/Widget.Rampify.Button.Delete" />

    </LinearLayout>
</ScrollView>