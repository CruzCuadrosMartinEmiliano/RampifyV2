PORT=3000
NODE_ENV=production
FRONTEND_URL=https://TU_FRONTEND.vercel.app
CORS_ORIGINS=https://TU_FRONTEND.vercel.app
APP_PUBLIC_URL=https://TU_FRONTEND.vercel.app

# Supabase PostgreSQL connection string. Configure this in Render, not in Git.
DB_DRIVER=postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
DB_POOL_SIZE=10

JWT_SECRET=replace-with-a-long-random-secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=replace@example.com
MAIL_PASS=replace-with-an-app-password
MAIL_FROM="Rampify <replace@example.com>"
